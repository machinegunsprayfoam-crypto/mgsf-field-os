# ─────────────────────────────────────────────────────────────────────────────
# MGSF Field-OS — Environment Variables (TEMPLATE)
# Copy to .env.local for local dev (never commit .env.local).
# Set all Production/Preview values in Vercel → Project Settings → Environment
# Variables. NEVER put a real secret or the crew code in this committed file.
# Every variable the code reads is listed here; primaries shown, (or ALT) noted.
# ─────────────────────────────────────────────────────────────────────────────

# ── SECURITY (set before go-live) ─────────────────────────────────────────────
# Access gate for Klyfton + all data endpoints. Pick any string; crew enters it
# once in the app. Set this in Vercel (Production scope) — NOT here. Leave blank.
CREW_CODE=

# Protects scheduled/cron endpoints (/api/axle, /api/alerts, etc.) from external
# callers. The Alert Nerve (/api/alerts) REQUIRES it (header x-cron-secret; fail-closed).
CRON_SECRET=
# (Fallback name the axle endpoint also accepts if CRON_SECRET is unset.)
AXLE_SECRET=

# Verifies INBOUND webhook callers (/api/act, /api/notify receivers). Without it
# those receivers accept unauthenticated calls — set before exposing them.
WEBHOOK_SECRET=

# ── CORE AI ───────────────────────────────────────────────────────────────────
# Required — powers all Klyfton agents.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults are set in code).
KLYFTON_MODEL=
ENGINEER_MODEL=
EMBED_MODEL=text-embedding-3-small

# Monthly Klyfton AI spend cap in USD (e.g. 50). Arms the ATS budget governor.
KLYFTON_MONTHLY_BUDGET_USD=

# ── FREE / FALLBACK AI PROVIDERS (all optional) ─────────────────────────────
# api/provider.js is one OpenAI-compatible hub with many backends. Set ANY of these
# and chatWithFallback will use it when Claude is unavailable or the ATS monthly cap
# has throttled us — Klyfton degrades to a free model instead of going dark.
# The five below have free tiers; Groq/Cerebras/Together/Gemini/OpenRouter are free
# to start. Each stays completely inert until its key is set.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
# Paid alternates through the same hub.
XAI_API_KEY=
MISTRAL_API_KEY=

# ── OPENAI (optional) ─────────────────────────────────────────────────────────
# Enables semantic long-term memory (requires Supabase too) + TTS voice.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=
# Self-hosted / OpenAI-compatible endpoint (e.g. LM Studio, Ollama).
OPENAI_COMPAT_URL=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=

# ── SUPABASE (brain / memory / events) ────────────────────────────────────────
# Run db/schema.sql once in the Supabase SQL editor before enabling.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── HUBSPOT (CRM) ─────────────────────────────────────────────────────────────
HUBSPOT_TOKEN=

# ── TWILIO (SMS / voice) ──────────────────────────────────────────────────────
# The trio + OWNER_SMS also arm the Alert Nerve (/api/alerts) — owner SMS alerts on
# gov deadlines, stale leads, aging estimates. Dormant + honest until all are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Owner's number for alerts (recipient — the Alert Nerve texts ONLY this number).
OWNER_SMS=

# ── GOOGLE ────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
# Apps Script web-app URL + token for Google Drive backup/sync (arms "drive").
GDRIVE_WEBAPP_URL=
GDRIVE_TOKEN=

# ── SAM.GOV (GovCon scanner) ──────────────────────────────────────────────────
SAM_API_KEY=

# ── ELEVENLABS (voice synthesis, optional) ────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# ── CUSTOMER PORTAL ───────────────────────────────────────────────────────────
# HMAC secret for per-record portal tokens. Set to enable /portal.html.
PORTAL_SECRET=
PORTAL_BASE_URL=

# ── WEBHOOKS / ALERTS ─────────────────────────────────────────────────────────
# Biggest single unlock — powers arms + the universal bus + all automation crons.
# (The app also accepts NOTIFY_WEBHOOK_URL as a fallback name for this.)
ALERTS_WEBHOOK_URL=

# ── BRAIN (optional) ──────────────────────────────────────────────────────────
# InfraNodus key for knowledge-graph content-gap analysis.
INFRANODUS_API_KEY=

# ── OPTIONAL / ADVANCED (defaults in code — leave blank unless tuning) ─────────
PRICING_CSV_URL=
# ATS fuel/battery governor tuning.
ATS_TRANSFER_PCT=
ATS_BATTERY_MODEL=
BATTERY_CAPACITY=
# Hive timing budgets (ms).
KLYFTON_SYNTH_RESERVE_MS=
KLYFTON_WALL_MS=
