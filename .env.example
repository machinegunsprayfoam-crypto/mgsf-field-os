# ─────────────────────────────────────────────────────────────────────────────
# MGSF Field-OS — Environment Variables
# Copy this file to .env.local for local dev (never commit .env.local).
# Set all production/preview values in Vercel → Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── SECURITY (set before go-live) ─────────────────────────────────────────────
# Gates Klyfton AI and all data endpoints (/api/command-center, /api/brain-context, etc.).
# Pick any string. Crew enters it once in the app. Without it the endpoints are OPEN.
CREW_CODE=1775

# Protects scheduled/cron endpoints (/api/axle, etc.) from external callers.
CRON_SECRET=

# Protects webhook-receiver endpoints (/api/act, /api/notify, /api/daily-brief, etc.).
ALERTS_WEBHOOK_SECRET=

# ── CORE AI ───────────────────────────────────────────────────────────────────
# Required — powers all Klyfton agents.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults are set in code).
KLYFTON_MODEL=
ENGINEER_MODEL=
EMBED_MODEL=text-embedding-3-small

# Monthly Klyfton AI spend cap in USD (e.g. 50).
KLYFTON_MONTHLY_BUDGET_USD=

# ── OPENAI (optional) ─────────────────────────────────────────────────────────
# Enables semantic long-term memory (requires Supabase too).
OPENAI_API_KEY=
OPENAI_TTS_MODEL=
# Self-hosted / compatible endpoint (e.g. LM Studio, Ollama).
OPENAI_COMPAT_URL=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=

# ── SUPABASE (brain / memory / events) ────────────────────────────────────────
# Run db/schema.sql once in the Supabase SQL editor before enabling.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── HUBSPOT (CRM) ─────────────────────────────────────────────────────────────
HUBSPOT_TOKEN=
HUBSPOT_API_KEY=

# ── TWILIO (SMS / voice) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Recipient for owner alerts.
OWNER_SMS=

# ── GOOGLE ────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
# Apps Script web-app URL for Google Drive sync.
GOOGLE_APPS_SCRIPT_URL=
# OAuth token for Google Drive access.
GDRIVE_TOKEN=

# ── SAM.GOV (GovCon scanner) ──────────────────────────────────────────────────
SAMGOV_API_KEY=

# ── ELEVENLABS (voice synthesis) ──────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# ── CUSTOMER PORTAL ───────────────────────────────────────────────────────────
# HMAC secret for per-record portal tokens. Set to enable /portal.html.
PORTAL_SECRET=
PORTAL_BASE_URL=

# ── WEBHOOKS / ALERTS ─────────────────────────────────────────────────────────
NOTIFY_WEBHOOK_URL=
ALERTS_WEBHOOK_URL=

# ── OPTIONAL / ADVANCED ───────────────────────────────────────────────────────
MAPS_API_KEY=
INFRANODUS_API_KEY=
PRICING_CSV_URL=
# ATS / battery system (edge-case hardware integrations).
ATS_BATTERY_MODEL=
ATS_TRANSFER_PCT=
BATTERY_CAPACITY=
KLYFTON_SYNTH_RESERVE_MS=
KLYFTON_WALL_MS=
