# ─────────────────────────────────────────────────────────────────────────────
# MGSF Field-OS — Environment Variables (TEMPLATE)
# Copy to .env.local for local dev (never commit .env.local).
# Set all Production/Preview values in Vercel → Project Settings → Environment
# Variables. NEVER put a real secret or the crew code in this committed file.
# ─────────────────────────────────────────────────────────────────────────────

# ── SECURITY (set before go-live) ─────────────────────────────────────────────
# Access gate for Klyfton + all data endpoints. Pick any string; crew enters it
# once in the app. Set this in Vercel (Production scope) — NOT here. Leave blank.
CREW_CODE=

# Protects scheduled/cron endpoints (/api/axle, etc.) from external callers.
CRON_SECRET=

# ── CORE AI ───────────────────────────────────────────────────────────────────
# Required — powers all Klyfton agents.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults are set in code).
KLYFTON_MODEL=
ENGINEER_MODEL=
EMBED_MODEL=text-embedding-3-small

# Monthly Klyfton AI spend cap in USD (e.g. 50).
KLYFTON_MONTHLY_BUDGET_USD=

# ── OPENAI (optional) ─────────────────────────────────────────────────────────
# Enables semantic long-term memory (requires Supabase too) + TTS voice.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=

# ── SUPABASE (brain / memory / events) ────────────────────────────────────────
# Run db/schema.sql once in the Supabase SQL editor before enabling.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── HUBSPOT (CRM) ─────────────────────────────────────────────────────────────
HUBSPOT_TOKEN=

# ── TWILIO (SMS / voice) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_SMS=

# ── GOOGLE ────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── SAM.GOV (GovCon scanner) ──────────────────────────────────────────────────
SAM_API_KEY=

# ── ELEVENLABS (voice synthesis, optional) ────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── CUSTOMER PORTAL ───────────────────────────────────────────────────────────
# HMAC secret for per-record portal tokens. Set to enable /portal.html.
PORTAL_SECRET=
PORTAL_BASE_URL=

# ── WEBHOOKS / ALERTS ─────────────────────────────────────────────────────────
# Biggest single unlock — powers arms + the universal bus + all automation crons.
ALERTS_WEBHOOK_URL=

# ── OPTIONAL / ADVANCED ───────────────────────────────────────────────────────
PRICING_CSV_URL=
